{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcanevet/bevy_swarm/raw/main/docs/report-schema.json",
  "title": "bevy_swarm PlaytestReport",
  "description": "Public JSON contract for bevy_swarm playtest reports. Breaking changes require a schema_version bump and CHANGELOG entry.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "violations",
    "metrics",
    "coverage",
    "frame_count",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Report format version. Stays 1 until the v0.2 release freezes it."
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "crash"
      ],
      "description": "Run outcome. crash is ungated by the known-issues system (T13)."
    },
    "violations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/violation"
      }
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "frame_count": {
      "type": "integer",
      "minimum": 0
    },
    "tps": {
      "type": "integer",
      "minimum": 0,
      "description": "Configured ticks-per-second of the run (A1)."
    },
    "simulated_duration_s": {
      "type": "number",
      "minimum": 0,
      "description": "Simulated duration in seconds (frame_count / tps) (A1)."
    },
    "wall_time_s": {
      "type": "number",
      "minimum": 0,
      "description": "Wall-clock duration of the run loop in seconds (E2; used for JUnit testcase time)."
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "action_log": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action_entry"
      }
    },
    "game_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "cheat_count": {
      "type": "integer",
      "minimum": 0
    },
    "system_coverage": {
      "$ref": "#/$defs/system_coverage"
    },
    "unreplayable_actions": {
      "type": "integer",
      "description": "Intent-audit entries that cannot be converted to replay intents"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Non-fatal warnings"
    },
    "pre_ready_frames": {
      "type": "integer",
      "minimum": 0,
      "description": "Frames spent waiting for GameReady before the scenario began"
    },
    "action_effect_rate": {
      "$ref": "#/$defs/action_effect_rate"
    },
    "choices": {
      "$ref": "#/$defs/choices"
    },
    "robustness": {
      "$ref": "#/$defs/robustness"
    },
    "discovered_surface": {
      "$ref": "#/$defs/discovered_surface"
    },
    "state_trace": {
      "type": [
        "array",
        "null"
      ],
      "description": "Per-frame state digests (opt-in, golden trajectory support).",
      "items": {
        "$ref": "#/$defs/frame_digest"
      }
    },
    "scope": {
      "$ref": "#/$defs/checked_scope"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "violation": {
      "type": "object",
      "required": [
        "rule",
        "target",
        "first_frame",
        "last_frame",
        "count",
        "detail",
        "last_detail"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "description": "Must be a name from the rule registry (docs/rules.md)."
        },
        "target": {
          "type": "string"
        },
        "first_frame": {
          "type": "integer",
          "minimum": 0
        },
        "last_frame": {
          "type": "integer",
          "minimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "detail": {
          "type": "string"
        },
        "last_detail": {
          "type": "string",
          "description": "Detail at the most recent occurrence (trend/debug)"
        },
        "fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "description": "Stable failure identity (T1); null for informational rules"
        },
        "fingerprint_scheme": {
          "type": "integer",
          "const": 1,
          "description": "Fingerprint scheme version (frozen at 1 for v0.2)"
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "input_count",
        "frame_count",
        "frame_ms_p99",
        "worst_frame_ms",
        "crash_detected"
      ],
      "properties": {
        "input_count": {
          "type": "integer",
          "minimum": 0
        },
        "frame_count": {
          "type": "integer",
          "minimum": 0
        },
        "frame_ms_p99": {
          "type": "number"
        },
        "worst_frame_ms": {
          "type": "number"
        },
        "crash_detected": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "intents_emitted",
        "test_api_paths_read",
        "resets_invoked",
        "chaos_surface_indices"
      ],
      "properties": {
        "intents_emitted": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "test_api_paths_read": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "resets_invoked": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "chaos_surface_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "system_coverage": {
      "type": "object",
      "required": [
        "executed",
        "registered"
      ],
      "properties": {
        "executed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "registered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "action_entry": {
      "type": "object",
      "required": [
        "frame",
        "elapsed_ms",
        "source",
        "action"
      ],
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "number"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "description": "BotScenario",
              "required": [
                "BotScenario"
              ],
              "properties": {
                "BotScenario": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "string",
              "enum": [
                "Agent",
                "Manual"
              ]
            }
          ]
        },
        "action": {
          "type": "string"
        },
        "details": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_detail": {
          "type": "string",
          "description": "Detail at the most recent occurrence (trend/debug)"
        }
      },
      "additionalProperties": false
    },
    "timed_action": {
      "type": "object",
      "required": [
        "frame",
        "source",
        "action"
      ],
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "description": "BotScenario",
              "required": [
                "BotScenario"
              ],
              "properties": {
                "BotScenario": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "string",
              "enum": [
                "Agent",
                "Manual"
              ]
            }
          ]
        },
        "action": {
          "type": "string"
        },
        "details": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_detail": {
          "type": "string",
          "description": "Detail at the most recent occurrence (trend/debug)"
        }
      },
      "additionalProperties": false
    },
    "action_effect_rate": {
      "type": "object",
      "description": "I5: per-action effect rates (key -> {effective, total})",
      "additionalProperties": {
        "type": "object",
        "required": [
          "effective",
          "total"
        ],
        "properties": {
          "effective": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "choices": {
      "type": "array",
      "description": "J0: recorded bot choices (frame, reduced value, bound) \u2014 replay via bot.choices",
      "items": {
        "type": "object",
        "required": [
          "frame",
          "value",
          "bound"
        ],
        "properties": {
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "value": {
            "type": "integer",
            "minimum": 0
          },
          "bound": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "robustness": {
      "type": "object",
      "description": "J1: STL-style signed robustness margins per invariant",
      "properties": {
        "per_invariant": {
          "type": "object",
          "description": "invariant name -> [min rho over run, frame of min, normalized min]",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "overall": {
          "type": [
            "number",
            "null"
          ],
          "description": "min over invariants of normalized min; < 0 iff some invariant failed"
        }
      },
      "required": [
        "per_invariant",
        "overall"
      ],
      "additionalProperties": false
    },
    "discovered_surface": {
      "type": "object",
      "description": "Z4: input surface discovered by differential probing (optional)",
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/effect"
              }
            ]
          }
        },
        "mouse_buttons": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/effect"
              }
            ]
          }
        },
        "mouse_motion": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/effect"
            }
          ]
        },
        "wheel": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/effect"
            }
          ]
        },
        "gamepad_buttons": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/effect"
              }
            ]
          }
        },
        "gamepad_axes": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/effect"
              }
            ]
          }
        },
        "probed_at": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "readers": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "confidence": {
          "type": "string",
          "enum": [
            "exact",
            "statistical"
          ]
        },
        "pruned_devices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "keys",
        "mouse_buttons",
        "mouse_motion",
        "wheel",
        "gamepad_buttons",
        "gamepad_axes",
        "probed_at",
        "readers",
        "confidence",
        "pruned_devices"
      ],
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "description": "Z4: a differential effect (first divergence + changed percept keys)",
      "properties": {
        "first_divergence_frame_delta": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "first_divergence_frame_delta",
        "changed"
      ],
      "additionalProperties": false
    },
    "frame_digest": {
      "type": "object",
      "required": [
        "frame",
        "hash"
      ],
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 0
        },
        "hash": {
          "type": "integer"
        },
        "snapshot": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "checked_scope": {
      "type": "object",
      "description": "Z1: contract tier + oracle families that ran/were skipped, and actuators used.",
      "properties": {
        "tier": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "zero",
            "observable",
            "semantic",
            null
          ]
        },
        "active": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inactive": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          }
        },
        "actuators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fingerprint_summary": {
      "type": "object",
      "required": [
        "fingerprint",
        "rule",
        "first_seen_seed",
        "occurrences"
      ],
      "properties": {
        "fingerprint": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "first_seen_seed": {
          "type": "integer",
          "minimum": 0
        },
        "occurrences": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "run_violation": {
      "type": "object",
      "required": [
        "rule",
        "detail"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        }
      }
    },
    "run_summary": {
      "type": "object",
      "required": [
        "seed",
        "status",
        "violations_count",
        "frame_count",
        "duration_ms",
        "violations"
      ],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "crash"
          ]
        },
        "violations_count": {
          "type": "integer",
          "minimum": 0
        },
        "frame_count": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "violations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run_violation"
          }
        }
      }
    },
    "regression_replay_outcome": {
      "type": "object",
      "required": [
        "fingerprint",
        "status"
      ],
      "properties": {
        "fingerprint": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "still_failing",
            "now_passing"
          ]
        }
      }
    },
    "gate_summary": {
      "type": "object",
      "required": [
        "new",
        "regressed",
        "known",
        "muted"
      ],
      "properties": {
        "new": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regressed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "muted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "autotest_gate_summary": {
      "type": "object",
      "required": [
        "classification",
        "passed"
      ],
      "properties": {
        "classification": {
          "$ref": "#/$defs/gate_summary"
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "autotest_report": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_tier",
        "harness_mode",
        "scope",
        "budget",
        "runs",
        "failures",
        "minimized",
        "early_stop",
        "coverage",
        "timing",
        "gate"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "contract_tier": {
          "type": "string",
          "enum": [
            "zero",
            "observable",
            "semantic"
          ]
        },
        "harness_mode": {
          "type": "string",
          "enum": [
            "in_process"
          ]
        },
        "scope": {
          "$ref": "#/$defs/checked_scope"
        },
        "budget": {
          "type": "object",
          "required": [
            "seeds_run",
            "total_duration_s",
            "parallelism"
          ],
          "properties": {
            "seeds_run": {
              "type": "integer",
              "minimum": 0
            },
            "total_duration_s": {
              "type": "number",
              "minimum": 0
            },
            "parallelism": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run_summary"
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fingerprint_summary"
          }
        },
        "minimized": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fingerprint",
              "rule",
              "seed",
              "minimal_inputs_len"
            ],
            "properties": {
              "fingerprint": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "seed": {
                "type": "integer",
                "minimum": 0
              },
              "minimal_inputs_len": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "early_stop": {
          "type": "boolean"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "timing": {
          "type": "object",
          "required": [
            "start",
            "end",
            "elapsed_ms"
          ],
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "elapsed_ms": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "run_id": {
          "type": "string"
        },
        "discovered_surface": true,
        "regressions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/regression_replay_outcome"
          }
        },
        "gate": {
          "$ref": "#/$defs/autotest_gate_summary"
        }
      },
      "additionalProperties": false
    }
  }
}
