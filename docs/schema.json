              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "float",
                  "type": "number"
                },
                {
                  "format": "float",
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "intent": {
              "const": "move",
              "type": "string"
