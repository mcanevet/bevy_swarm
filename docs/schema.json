  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bot": {
      "$ref": "#/$defs/BotConfig"
    },
    "check_determinism": {
      "default": null,
      "description": "A4: opt-in determinism check. None = disabled; Some(N) means\nrun the scenario N times (N >= 2) with the same seed and compare\nstate digests. Reports \"nondeterministic\" rule on divergence.",
      "format": "uint",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "compare_golden": {
      "description": "Z11/swarm-s5z: opt-in golden-trajectory comparison. Some(dir)\npoints at a recorded golden set (see `crate::golden::record_golden`);\nthe run's per-frame state digests are compared against the stored\ngolden for `scenario-{name}-{seed}` and a `golden_diverged`\nviolation is reported on the first differing frame (or a digest\ncount mismatch). Requires `name` to select the entry.",
      "type": [
        "string",
        "null"
      ]
    },
    "deny_ambiguities": {
      "default": false,
      "description": "Fail the run (ScenarioError::Rejected listing the ambiguities) when\nany schedule has conflicting systems with no order. Opt-in: many\ngames have benign ambiguities.",
      "type": "boolean"
    },
    "duration_s": {
      "default": 15.0,
      "format": "float",
      "type": "number"
    },
    "invariants": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Invariant"
      },
      "type": "array"
    },
    "liveness": {
      "$ref": "#/$defs/LivenessConfig",
      "default": {
        "mode": "real_time",
        "timeout_s": 2.0,
        "watch": []
      },
      "description": "I4: liveness configuration (default 2s timeout, real-time mode)."
    },
    "name": {
      "description": "Stable scenario name. Used for golden-trajectory file naming\n(`scenario-NAME-SEED`): scenarios recorded into a golden set\nmust have unique names so reordering the list cannot rename or\noverwrite files. Optional for plain playtests.",
      "type": [
        "string",
        "null"
      ]
    },
    "oracles": {
      "default": null,
      "description": "I3: typed-oracle selection. None = run ALL registered typed\noracles; Some(names) restricts to the listed ones. Unknown names\nreject at load time (ScenarioError::Rejected).",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "setup": {
      "$ref": "#/$defs/Setup",
      "default": {
        "cheats": [],
        "resets": []
      }
    },
    "simulated_time": {
      "default": true,
      "description": "Drive `Time` with a fixed delta of 1/tps (deterministic, the default)\ninstead of the wall clock. Turn off only for soak tests that want\nreal-time behaviour.",
      "type": "boolean"
    },
    "single_threaded": {
      "default": true,
      "description": "Run every schedule on Bevy's SingleThreadedExecutor (deterministic\nsystem order for a given schedule graph). Default true: playtests\nvalue reproducibility over throughput. Parallelism comes from\nrunning many scenarios at once, not from threading one App.",
      "type": "boolean"
    },
    "strict_warnings": {
      "default": false,
      "description": "dbt: escalate warning-class violations (bevy_warning, log_warn)\nto gating severity. Default false: those rules are informational\nbecause headless runs routinely trip render/audio warnings that\nare benign without a GPU or audio device. Opt in when your game\nshould never log warnings.",
      "type": "boolean"
    },
    "tps": {
      "default": 60,
      "description": "Simulation ticks per second. Each `app.update()` advances simulated\ntime by exactly 1/tps when `simulated_time` is true.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "bot"
  ],
  "title": "Scenario",
  "type": "object"
}