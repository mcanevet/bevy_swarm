    "ReplayInput": {
      "additionalProperties": false,
      "description": "A typed replay intent. Whatever intent sequence a scenario author\n(or a recorded human play session translated through the adapter)\nprovides is replayed verbatim.",
      "properties": {
        "frame": {
          "format": "uint64",
          "minimum": 0,
